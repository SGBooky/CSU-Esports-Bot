# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application (Client) ID from the same developer portal page
CLIENT_ID=your_application_client_id_here

# Your Discord server (guild) ID — right-click server icon with Developer Mode on
GUILD_ID=your_guild_id_here

# Staff channel for each form type (right-click channel → Copy Channel ID)
CHANNEL_NECC_DISCORD_CONNECTED=channel_id_for_necc_account
CHANNEL_NECC_DISCORD_JOIN=channel_id_for_necc_discord
CHANNEL_DUES_PAID=channel_id_for_dues
CHANNEL_IMLEAGUE_FORMS=channel_id_for_imleagues
